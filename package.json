{
  "name": "hotelumo",
  "version": "1.0.0",
  "private": false,
  "description": "Hotelumo CLI — manage the reservations, guests, rooms and rates of your hotels from the terminal",
  "license": "Apache-2.0",
  "repository": "github:hotelumo/cli",
  "homepage": "https://www.hotelumo.com/",
  "author": "Hotelumo",
  "type": "commonjs",
  "main": "./dist/index.js",
  "bin": {
    "hotelumo": "./dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "develop": "node index.js",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "publish:repo": "node scripts/publishCli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "hotel",
    "property-management",
    "reservations",
    "availability",
    "rates",
    "hospitality",
    "cli"
  ],
  "dependencies": {
    "commander": "8.3.0",
    "inquirer": "8.2.5",
    "node-localstorage": "2.2.1"
  },
  "devDependencies": {
    "@monorepool/agentfirst": "0.0.0",
    "esbuild": "0.25.4",
    "eslint": "10.8.0"
  }
}
